# Local database (matches docker-compose.yaml)
DB_URL_LOCAL=postgresql://uniuser_db:12345@localhost:5432/unitmrw_db

# Optional: production database outside Vercel (used when NODE_ENV=production)
DB_URL_PROD=

# Set automatically on Vercel by the Neon integration
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# AI provider: gemini (default) or deepseek
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
